{
  "name": "gym-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build -c vite.mcp.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.mcp.json",
    "dataset:update": "node scripts/update-dataset.mjs",
    "build:mcp": "vite build -c vite.mcp.config.ts",
    "build:cloud": "vite build -c vite.cloud.config.ts",
    "test:built": "vitest run -c vitest.built.config.ts",
    "build:versions": "node scripts/build-versions.mjs"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "nostr-tools": "^2.25.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
